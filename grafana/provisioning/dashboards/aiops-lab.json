{
  "title": "AIOps Lab — Service Overview",
  "uid": "aiops-lab-main",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "title": "Request Rate (req/min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "rate(aiops_lab_api_requests_total[1m]) * 60",
        "legendFormat": "{{route}} {{method}}"
      }]
    },
    {
      "id": 2, "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "title": "Orders Created / min",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "rate(aiops_lab_orders_created_total[1m]) * 60",
        "legendFormat": "{{status}} — {{item}}"
      }]
    },
    {
      "id": 3, "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "title": "Payment Success vs Failed / min",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "rate(aiops_lab_charges_total[1m]) * 60",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 4, "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "title": "API Latency p50 / p99 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(aiops_lab_api_request_duration_milliseconds_bucket[2m]))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.50, rate(aiops_lab_api_request_duration_milliseconds_bucket[2m]))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 5, "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "title": "Payment Duration p50 / p99 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(aiops_lab_charge_duration_milliseconds_bucket[2m]))",
          "legendFormat": "p99 {{status}}"
        },
        {
          "expr": "histogram_quantile(0.50, rate(aiops_lab_charge_duration_milliseconds_bucket[2m]))",
          "legendFormat": "p50 {{status}}"
        }
      ]
    },
    {
      "id": 6, "gridPos": { "x": 0, "y": 16, "w": 6, "h": 6 },
      "title": "Payment Error Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "rate(aiops_lab_charges_total{status='failed'}[5m]) / rate(aiops_lab_charges_total[5m]) * 100",
        "legendFormat": "Error %"
      }]
    },
    {
      "id": 7, "gridPos": { "x": 6, "y": 16, "w": 6, "h": 6 },
      "title": "Total Revenue (THB)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyTHB" } },
      "targets": [{
        "expr": "aiops_lab_revenue_THB_total",
        "legendFormat": "Revenue"
      }]
    },
    {
      "id": 8, "gridPos": { "x": 12, "y": 16, "w": 6, "h": 6 },
      "title": "Orders / min",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqpm" } },
      "targets": [{
        "expr": "rate(aiops_lab_orders_created_total[1m]) * 60",
        "legendFormat": "Orders"
      }]
    },
    {
      "id": 9, "gridPos": { "x": 18, "y": 16, "w": 6, "h": 6 },
      "title": "Node.js Event Loop p99 (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [{
        "expr": "aiops_lab_nodejs_eventloop_delay_p99_seconds * 1000",
        "legendFormat": "{{job}}"
      }]
    },
    {
      "id": 10, "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "title": "HTTP Client Duration — inter-service calls (p99 ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(aiops_lab_http_client_duration_milliseconds_bucket[2m]))",
        "legendFormat": "{{job}} → {{http_host}}"
      }]
    }
  ],
  "schemaVersion": 39
}
